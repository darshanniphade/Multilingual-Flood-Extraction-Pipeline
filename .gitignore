# ---------------------------------------------------------------------------
# Data & artifacts — NOT source. The corpus is ~25 GB across ~5.2M files and
# lives entirely outside version control.
# ---------------------------------------------------------------------------
data/

# Junction/symlink farms pointing back into data/ (Windows reparse points —
# git follows these and would pull the whole corpus in).
*_links/
data2022_links/

# Pipeline run state: checkpoints, resume indexes, per-article records.
# These are regenerated by re-running a stage (translator/state* is ~349 MB).
state/
state_*/
checkpoints/
*.jsonl
*.csv

# Corpus-scale intermediates
translated_titles*
translated_articles/
flood_events/
extracted/
only_english/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Models & logs
# ---------------------------------------------------------------------------
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.gguf
models/
hf_cache/
*.log
logs/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
Desktop.ini
